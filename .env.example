DATABASE_NAME=tienda_perritos
DATABASE_USER=postgres
DATABASE_PASSWORD=cambiar_esta_clave
POSTGRES_HOST_PORT=5433

# Secreto para firmar JWT (minimo 32 caracteres). Si se omite, docker-compose usa un valor SOLO de desarrollo.
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

